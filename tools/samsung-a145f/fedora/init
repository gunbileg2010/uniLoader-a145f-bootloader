#!/bin/busybox sh
# Minimal initramfs for booting Fedora from an SD card on the A145F vendor kernel.
#
# Everything is logged to /dev/kmsg, so it ends up in the ramoops console and
# uniLoader shows it after the next (warm) reboot. There is no other output:
# this kernel has no text console on the screen.
#
# SAFE BY DEFAULT: unless the Fedora root contains a file named .fedora-go,
# this is a dry run. It finds the root, saves a log on it, and reboots.
#   touch /path/to/sd-root/.fedora-go     # then it really boots Fedora

/bin/busybox mount -t devtmpfs devtmpfs /dev
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
exec </dev/null >/dev/kmsg 2>&1
/bin/busybox --install -s /bin
export PATH=/bin:/sbin

say() { echo "fedora-initramfs: $*"; }

# --- on-screen progress marks ------------------------------------------------
# The kernel has no text console, no RAM log survives a forced reset, and USB
# may not come up, so draw progress straight into the framebuffer that uniLoader
# set up (0xfa000000, 1080x2408 ARGB8888, 4096 B = 1 page ~ 1 pixel row).
# Needs /dev/mem; failures are ignored. Bands (top to bottom of the screen):
#   green bands near the top   stage reached (1 started, 2 modules loaded, 3 usb tried,
#                              4 root found, 5 about to switch_root / reboot)
#   white ticks, from ~row 800 one per module loaded; a fat red tick = insmod failed
#   red band at row ~650       watchdog fired (a hang)
FBPAGE=1024000
mkpat() { # name, 4 bytes as octal escapes (B G R A)
	i=0
	while [ $i -lt 1024 ]; do printf "$2"; i=$((i + 1)); done > "/$1"
}
mkpat white '\377\377\377\377'
mkpat red '\000\000\377\377'
mkpat green '\000\377\000\377'
mk() { # colour, first page, pages
	dd if="/$1" of=/dev/mem bs=4096 seek=$((FBPAGE + $2)) count=$3 2>/dev/null
}
stage=0
mark_stage() { # draws one more green band
	stage=$((stage + 1))
	mk green $((60 + stage * 60)) 30
}
tick=0
mark_mod() { # $1 = ok|bad
	tick=$((tick + 1))
	if [ "$1" = ok ]; then mk white $((800 + tick * 5)) 2; else mk red $((800 + tick * 5)) 4; fi
}

# 'b' = plain reboot (RAM and the log survive). 'c' = crash, only as a fallback.
reboot_in() {
	say "rebooting in $1 s"
	sleep "$1"
	echo b > /proc/sysrq-trigger
	sleep 5
	echo c > /proc/sysrq-trigger
}

show_parts() {
	while read -r l; do
		[ -n "$l" ] && say "partitions: $l"
	done < /proc/partitions
}

say "start"
mark_stage

# Watchdog: if anything below hangs, reboot after 150 s so the log survives
# in RAM (a manual power cycle garbles it). Killed before switch_root.
( sleep 150; dd if=/red of=/dev/mem bs=4096 seek=$((FBPAGE + 650)) count=40 2>/dev/null; echo "fedora-initramfs: WATCHDOG, hang detected, rebooting" > /dev/kmsg; sleep 1; echo b > /proc/sysrq-trigger ) &
WD=$!

# Load vendor modules. modules.min (made by build_fedora_ramdisk.sh) holds only
# what the SD controller needs: clocks, pinctrl, PMIC regulators, dw_mmc*.
# The full stock list loads camera, audio, debug and TrustZone-monitor drivers
# that Fedora does not need and that can hang or reset the phone.
L=/lib/modules/modules.min
[ -f "$L" ] || L=/lib/modules/modules.load
say "loading modules from $L"
ok=0
bad=0
while read -r m; do
	m=${m##*/}
	[ -n "$m" ] || continue
	say "insmod $m"
	if insmod "/lib/modules/$m" 2>/dev/null; then
		ok=$((ok + 1))
		mark_mod ok
	else
		bad=$((bad + 1))
		say "insmod $m failed"
		mark_mod bad
	fi
done < "$L"
say "modules: $ok loaded, $bad failed"
mark_stage

# USB serial gadget: the phone shows up on the PC as /dev/ttyACM0 and streams
# the kernel log (and keeps working after switch_root, where
# serial-getty@ttyGS0 gives a login). Best effort: failures are only logged.
setup_usb() {
	mount -t configfs none /sys/kernel/config 2>/dev/null
	G=/sys/kernel/config/usb_gadget/a145f
	if ! mkdir "$G" 2>/dev/null; then
		say "usb: no configfs gadget support"
		return 1
	fi
	echo 0x1d6b > "$G/idVendor"
	echo 0x0104 > "$G/idProduct"
	mkdir -p "$G/strings/0x409" "$G/configs/c.1/strings/0x409" "$G/functions/acm.usb0"
	echo a145f > "$G/strings/0x409/serialnumber"
	echo uniLoader > "$G/strings/0x409/manufacturer"
	echo "A145F Fedora log" > "$G/strings/0x409/product"
	echo serial > "$G/configs/c.1/strings/0x409/configuration"
	ln -s "$G/functions/acm.usb0" "$G/configs/c.1/" 2>/dev/null
	# The UDC shows up once dwc3 has probed; give it a few seconds.
	n=0
	u=""
	while [ -z "$u" ] && [ "$n" -lt 10 ]; do
		u=$(ls /sys/class/udc 2>/dev/null | head -n 1)
		[ -n "$u" ] || { n=$((n + 1)); sleep 1; }
	done
	say "usb: udc list: [$u]"
	if [ -z "$u" ]; then
		for l in $(dmesg | grep -i -E "dwc3|usb.*(phy|otg|gadget)|muic|usbpd|usb_notif" | tail -n 12 | tr ' ' '_'); do say "usb: dmesg $l"; done
		return 1
	fi
	if ! echo "$u" > "$G/UDC" 2>/dev/null; then
		say "usb: could not bind UDC $u"
		return 1
	fi
	# Samsung's OTG state machine starts the gadget only when the cable-detect
	# chain says VBUS is present. If that chain did not do it, force it.
	for f in $(find /sys -name b_sess 2>/dev/null); do
		say "usb: $f = $(cat "$f" 2>&1 | tr '\n' ' ')"
		echo 1 > "$f" 2>/dev/null
		sleep 1
		say "usb: $f now $(cat "$f" 2>&1 | tr '\n' ' ')"
	done
	for f in $(find /sys -name state -path '*dwc3*' 2>/dev/null | head -n 3); do
		say "usb: $f: $(cat "$f" 2>&1 | tr '\n' ' ')"
	done
	say "usb: udc state $(cat /sys/class/udc/$u/state 2>&1)"
	say "usb: gadget bound to $u, serial port /dev/ttyGS0"
	( cat /dev/kmsg > /dev/ttyGS0 ) &
	return 0
}

setup_usb
mark_stage

# Look for a partition holding a Fedora root. mmcblk0 is the internal eMMC
# (Android), so it is skipped on purpose.
find_root() {
	for d in /dev/mmcblk[1-9]p[0-9]* /dev/sd[a-z][0-9]*; do
		[ -b "$d" ] || continue
		if ! err=$(mount -t ext4 -o rw "$d" /mnt 2>&1); then
			say "mount $d: $err"
			continue
		fi
		if [ -x /mnt/usr/lib/systemd/systemd ]; then
			say "root is $d"
			return 0
		fi
		say "$d mounted but has no /usr/lib/systemd/systemd"
		umount /mnt
	done
	return 1
}

i=0
while ! find_root; do
	i=$((i + 1))
	[ $((i % 10)) -eq 0 ] && { say "waiting ($i s)"; show_parts; }
	[ "$i" -ge 60 ] && break
	sleep 1
done

if [ -x /mnt/usr/lib/systemd/systemd ]; then
	mark_stage
	mkdir -p /mnt/root 2>/dev/null
	dmesg > /mnt/root/initramfs-dmesg.txt 2>/dev/null
	if [ ! -e /mnt/.fedora-go ]; then
		say "dry run (no /.fedora-go on the root): log saved to /root/initramfs-dmesg.txt"
		sync
		umount /mnt
		reboot_in 90
	fi
	mark_stage
	say "switching root"
	kill $WD 2>/dev/null
	mount --move /dev /mnt/dev
	mount --move /proc /mnt/proc
	mount --move /sys /mnt/sys
	exec switch_root /mnt /usr/lib/systemd/systemd
fi

say "no Fedora root found"
mk red 500 40
show_parts
reboot_in 20
